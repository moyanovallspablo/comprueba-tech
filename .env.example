# Copia este archivo a .env.local y rellena los valores.

# Tag de afiliado de Amazon España (p. ej. "comprueba-21"). Se incrusta en el build:
# tras cambiarlo hay que volver a ejecutar `npm run build`. Vacío = se usa el tag de respaldo de lib/affiliate.ts.
NEXT_PUBLIC_AMAZON_TAG=

# Tag de afiliado de PcComponentes. También se incrusta en el build.
# Vacío = se usa el tag de desarrollo "demo" de lib/affiliate.ts.
NEXT_PUBLIC_PCCOMPONENTES_TAG=
